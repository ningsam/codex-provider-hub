{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Provider Hub",
  "version": "0.1.1",
  "identifier": "com.skylerenzi.codex-provider-hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex Provider Hub",
        "width": 1080,
        "height": 760,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "radius": 26
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/picker_guard_patch.py"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
